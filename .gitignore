# Dashboard state — contains your conversation text. Never commit.
app/.state.json

# Per-machine Claude Code tool approvals. Personal, accumulates over time, and grants
# shell permissions that shouldn't follow the repo to other people. The rest of
# .claude/ is tracked, so shared agents, skills and commands added later will ship.
.claude/settings.local.json

# Private working document — kept local, not part of the published prototype.
ai_crop_evaluation_breeding_context.md

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Scratch
*.tmp
*.log

# Derived databases. The tomato data.db is ~25 MB and rebuilds from the committed
# source workbook in about half a minute, so it is kept local rather than committed.
data/**/data.db
